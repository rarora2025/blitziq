# Everything is optional for local play. With nothing set, Blitz stores data in an
# embedded Postgres (PGlite) under .blitz/ and syncs devices over server-sent events.

# --- Supabase (production) ---
# Postgres connection string. Use the pooled "Transaction" URL from
# Supabase > Project Settings > Database (port 6543). The schema is created automatically.
DATABASE_URL=
# Used by the server to broadcast "lobby changed" pings over Supabase Realtime.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Used by browsers to subscribe to those pings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optional AI question drafts ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
